@charset "utf-8";

.plan-editor-tiptap-content .tiptap { outline: none; min-height: 200px; line-height: 1.625; }

.plan-editor-tiptap-content .tiptap [spellcheck] { text-decoration-skip-ink: none; }

.plan-editor-tiptap-content .tiptap h1 { margin-top: 0px; margin-bottom: 0.5rem; font-size: 1.25rem; font-weight: 500; line-height: 1.75rem; }

.plan-editor-tiptap-content .tiptap h2 { margin-top: 1.5rem; margin-bottom: 0.5rem; font-size: 1.125rem; font-weight: 500; line-height: 1.75rem; }

.plan-editor-tiptap-content .tiptap h3 { margin-top: 1.25rem; margin-bottom: 0.5rem; font-size: 1rem; font-weight: 500; line-height: 1.5rem; }

.plan-editor-tiptap-content .tiptap h4 { margin-top: 1rem; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; line-height: 1.25rem; }

.plan-editor-tiptap-content .tiptap p { text-indent: 0px; margin-top: 0px; margin-bottom: 0.75rem; padding-left: 0px; }

.plan-editor-tiptap-content .tiptap p:last-child { margin-bottom: 0px; }

.plan-editor-tiptap-content .tiptap ul, .plan-editor-tiptap-content .tiptap ol { margin-top: 0.5rem; margin-bottom: 0.5rem; padding-inline-start: 1.625rem; }

.plan-editor-tiptap-content .tiptap ul { list-style-type: disc; }

.plan-editor-tiptap-content .tiptap ol { list-style-type: decimal; }

.plan-editor-tiptap-content .tiptap li { padding: 0px !important; margin: 0px !important; padding-inline-start: 0.375rem !important; }

.plan-editor-tiptap-content .tiptap li p { margin: 0px !important; padding: 0px !important; }

.plan-editor-tiptap-content .tiptap li > ul, .plan-editor-tiptap-content .tiptap li > ol { margin-top: 0.25rem; margin-bottom: 0px; }

.plan-editor-tiptap-content .tiptap strong { font-weight: 600; }

.plan-editor-tiptap-content .tiptap a { color: var(--fg-primary); text-decoration: underline; }

.plan-editor-tiptap-content .tiptap blockquote { border-inline-start: 4px solid var(--border-translucent); color: var(--fg-tertiary); margin: 0.5rem 0px; padding-inline-start: 1rem; }

.plan-editor-tiptap-content .tiptap hr { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: var(--border-default) solid var(--border-translucent); margin: 1.5rem 0px; }

.plan-editor-tiptap-content .tiptap code:not(pre code) { background-color: var(--bg-translucent); background-image: linear-gradient(var(--bg-muted), var(--bg-muted)); color: var(--fg-secondary); border-radius: calc(-2px + 0.5rem); padding: 0.125rem 0.375rem; font-family: Menlo, Monaco, Consolas, "Courier New", monospace; font-size: 13.5px; line-height: 13.5px; }

.plan-editor-tiptap-content .tiptap pre { background-color: var(--bg-base); border-radius: calc(-2px + 0.5rem); margin: 0.5rem 0px; padding: 1rem; overflow-x: auto; line-height: 1 !important; }

.plan-editor-tiptap-content .tiptap pre code { background: 0px 0px; border-radius: 0px; padding: 0px; font-family: Menlo, Monaco, Consolas, "Courier New", monospace; font-size: 13px; line-height: 1 !important; }

.plan-editor-tiptap-content .tiptap table { border-collapse: collapse; width: 100%; min-width: 0px; max-width: 100%; margin-top: 0px; }

