@charset "utf-8";

@layer components {
  .pulse-calendar-today[data-hidden] { opacity: 0; pointer-events: none; scale: 0.9; }
  @media (prefers-reduced-motion: no-preference) {
  .pulse-calendar-today { transition: opacity .15s var(--ease-out-cubic), scale .15s var(--ease-out-cubic); }
}
  .pulse-calendar-day:focus-visible .pulse-calendar-day-fill { outline: 2px solid var(--border-focus); outline-offset: 2px; }
  .pulse-calendar-day-fill::before { content: ""; z-index: -1; border-radius: inherit; position: absolute; inset: 0px; }
  @media (hover: hover) {
  .pulse-calendar-day:hover .pulse-calendar-day-fill::before { background-color: var(--glow-neutral-hover); }
}
  .pulse-calendar-day:active .pulse-calendar-day-fill::before, .pulse-calendar-day[data-pressed] .pulse-calendar-day-fill::before { background-color: var(--glow-neutral-pressed); }
  .pulse-calendar-day[data-filled] .pulse-calendar-day-fill::before { background-color: var(--bg-inverse); }
  .pulse-calendar-day[data-filled] .pulse-calendar-day-fill { font-weight: 450; }
  .pulse-calendar-day:disabled:not([data-filled]) .pulse-calendar-day-fill::before { background-color: rgba(0, 0, 0, 0); }
}
